# Supabase (frontend — safe to expose)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Production deployment URL (no trailing slash)
# Leave unset for local dev — falls back to window.location.origin
VITE_SITE_URL=https://vendor-management-hazel.vercel.app

# Node.js backend API URL (Hostinger VPS)
VITE_API_URL=https://<your-vps-domain>
