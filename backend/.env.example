PORT=5000

# Supabase — service role ONLY (never send to frontend)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply-cognivend@ideassionlive.in
SMTP_PASS=<hostinger-smtp-password>
SMTP_FROM=CogniVend <noreply-cognivend@ideassionlive.in>

# Frontend URL (used to build links inside emails)
FRONTEND_URL=https://vendor-management-hazel.vercel.app

# Admin notification email
ADMIN_EMAIL=admin@ideassion.com

# Shared secret — must match x-webhook-secret header in Supabase webhook config
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=<random-hex-secret>
